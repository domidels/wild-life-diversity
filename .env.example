# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Only needed to run the pipeline from a laptop. In the cloud the same values live in:
#   - GitHub: Settings > Secrets and variables > Actions (DATABRICKS_HOST, DATABRICKS_HTTP_PATH, DATABRICKS_TOKEN)
#   - Databricks: secret scope "wildfire", key "firms_map_key"

# NASA FIRMS — free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Databricks — workspace hostname (no https://), SQL warehouse HTTP path, personal access token
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=
