# ---------------------------------------------------------------- secrets
# Never commit credentials: they live in .env locally, in Databricks secrets
# (scope "wildfire") and in GitHub repository secrets.
.env
.env.*
!.env.example
dbt/profiles.yml
.databrickscfg
*.pem
*.key

# ---------------------------------------------------------------- data
# Raw downloads live in the Unity Catalog volume, not in git.
/data/
*.tmp

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------- dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/

# ---------------------------------------------------------------- Databricks bundle state
.databricks/

# ---------------------------------------------------------------- editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
